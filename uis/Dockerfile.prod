FROM node:22-alpine

WORKDIR /app

ENV API_INTERNAL_URL=http://backend:8000
ENV NEXT_PUBLIC_API_BASE_URL=/backend

# Install website dependencies
COPY website/package*.json ./website/
RUN cd website && npm install

# Install backoffice dependencies
COPY backoffice/package*.json ./backoffice/
RUN cd backoffice && npm install

# Copy all UI source code
COPY . .

# Build production versions
RUN cd /app/website && npm run build
RUN cd /app/backoffice && npm run build

# Normalize production startup script and make it executable
RUN sed -i 's/\r$//' /app/start.prod.sh \
    && chmod +x /app/start.prod.sh

EXPOSE 3000 3001

CMD ["sh", "/app/start.prod.sh"]
