              "minimum": 0,
              "x-data-sensitivity": "no"
            },
            "outbound_order_id": {
              "description": "Identifier of the created outbound order.",
              "type": "string",
              "x-data-sensitivity": "pseudonymous business identifier"
            },
            "country": {
              "description": "Derived warehouse country: US or ES.",
              "type": "string",
              "enum": [
                "US",
                "ES"
              ],
              "x-data-sensitivity": "no"
            }
          },
          "required": [
            "warehouse",
            "client_id",
            "product_id",
            "product_category",
            "quantity",
            "outbound_order_id",
            "country"
          ],
          "additionalProperties": false
        }
      },
      "required": [
