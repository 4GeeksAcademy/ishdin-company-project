#Command to generate PASSWORD_RESET_SECRET_KEY
# openssl rand -hex 32
# RESEND_FROM_EMAIL ---> onboarding@resend.dev


JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

RESEND_API_KEY=
RESEND_FROM_EMAIL=
BACKOFFICE_BASE_URL=
PASSWORD_RESET_SECRET_KEY=

SUPABASE_URL=https://zqathadwqkhfjieewwyl.supabase.co
SUPABASE_KEY=

DATABASE_URL=

# -----------------------------------------------------------------------------
# Existing TinyDB auth database
# -----------------------------------------------------------------------------
TINYDB_PATH=services/trackflow_auth.json

# -----------------------------------------------------------------------------
# Supabase PostgreSQL business database
# Copy this from Supabase Dashboard -> Connect.
# Direct connection example:
# postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
# Session pooler is also acceptable and often easier from IPv4-only environments.
# -----------------------------------------------------------------------------
SUPABASE_DATABASE_URL=postgresql://postgres.zqathadwqkhfjieewwyl:[YOUR-PASSWORD]@aws-1-us-west-2.pooler.supabase.com:6543/postgres
DB_SSLMODE=require
SQL_ECHO=false

# Local/demo seed data.
# Set SEED_USER_UUID to the UUID of an EXISTING TinyDB user, or leave it unset
# and the seeder will use the first TinyDB user it finds.
SEED_DATA=true
SEED_USER_UUID=