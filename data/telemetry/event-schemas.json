{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://trackflow.example/schemas/telemetry-event.schema.json",
  "title": "TrackFlow Telemetry Event",
  "description": "Standard TrackFlow telemetry envelope with event-specific property allowlists. All producers must validate before emission.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "timestamp",
    "sessionId",
    "userId",
    "event_type",
    "schemaVersion",
    "requestId",
    "properties"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "minLength": 1,
      "description": "Globally unique event identifier; UUID recommended."
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "UTC ISO 8601 timestamp for when the event occurred."
    },
    "sessionId": {
      "type": [
        "string",
        "null"
      ],
      "description": "Opaque session identifier. Null is allowed for process events with no user session."
    },
    "userId": {
      "type": [
        "string",
        "null"
      ],
      "description": "Opaque authenticated TinyDB user UUID. Null for unauthenticated/process events; never email/name."
    },
    "event_type": {
      "type": "string",
      "enum": [
        "inbound_order_created",
        "outbound_order_created",
        "stock_threshold_triggered",
        "direct_stock_edit_rejected",
        "inventory_discrepancy_detected",
        "inventory_validation_failed",
        "outbound_order_rejected",
        "product_created",
        "product_updated",
        "login_succeeded",
        "login_failed",
        "session_expired",
        "authorization_denied",
        "section_viewed",
        "workflow_started",
        "workflow_completed",
        "workflow_abandoned",
        "api_latency_recorded",
        "api_error_recorded",
        "frontend_error_recorded",
        "page_load_recorded",
        "database_operation_slow",
        "background_process_failed",
        "integration_call_failed",
        "rate_limit_triggered",
        "request_validation_failed",
        "telemetry_schema_rejected",
        "telemetry_delivery_failed"
      ],
      "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$",
      "description": "Stable entity_action taxonomy."
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$",
      "description": "Telemetry schema version, e.g. 1.0."
    },
    "requestId": {
      "type": [
        "string",
        "null"
      ],
      "description": "Correlation ID joining frontend/backend/log activity. Null only when no request exists."
    },
    "properties": {
      "type": "object",
      "description": "Event-specific allowlisted payload."
    }
  },
  "oneOf": [
    {
      "title": "inbound_order_created",
      "description": "Emitted after an authenticated user successfully registers an inbound order that adds stock.",
      "properties": {
        "event_type": {
          "const": "inbound_order_created"
        },
        "properties": {
          "type": "object",
          "properties": {
            "warehouse": {
              "description": "Warehouse where stock was received. Allowed: los_angeles, zaragoza.",
              "type": "string",
              "enum": [
                "los_angeles",
                "zaragoza"
              ],
              "x-data-sensitivity": "no"
            },
            "client_id": {
              "description": "B2B client that owns the SKU.",
              "type": "string",
              "x-data-sensitivity": "pseudonymous business identifier"
            },
            "product_id": {
              "description": "SKU/product identifier.",
              "type": "string",
              "x-data-sensitivity": "pseudonymous business identifier"
            },
            "product_category": {
              "description": "fashion, electronics, or cosmetics.",
              "type": "string",
              "enum": [
                "fashion",
                "electronics",
                "cosmetics"
              ],
              "x-data-sensitivity": "no"
            },
            "quantity": {
              "description": "Quantity received; must be > 0.",
              "type": "integer",
              "minimum": 0,
              "x-data-sensitivity": "no"
            },
            "inbound_order_id": {
              "description": "Identifier of the created inbound order.",
              "type": "string",
              "x-data-sensitivity": "pseudonymous business identifier"
            },
            "country": {
              "description": "Derived warehouse country: US or ES, retained for future aggregation.",
              "type": "string",
              "enum": [
                "US",
                "ES"
              ],
              "x-data-sensitivity": "no"
            }
          },
          "required": [
            "warehouse",
            "client_id",
            "product_id",
            "product_category",
            "quantity",
            "inbound_order_id",
            "country"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "event_type",
        "properties"
      ]
    },
    {
